# Copy to .env for local use, or paste these into Vercel's Environment Variables.
# .env is gitignored — never commit real values.

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL unset to use the local shop.db file next to server.js.
# For Turso, both come from `turso db show` and `turso db tokens create`.
DATABASE_URL=libsql://your-database-name-yourorg.turso.io
DATABASE_AUTH_TOKEN=

# --- Sessions -------------------------------------------------------------
# Signs the login cookie. Without it, logins do not survive a restart.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- First admin account --------------------------------------------------
# Used ONLY when the admin table is empty. After the first run, change the
# password from inside the app; these are then ignored.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Marks cookies `secure` (HTTPS only). Vercel sets this automatically.
NODE_ENV=production

# Keeps sale timestamps on Bangladesh time when the server is not in the shop.
TZ=Asia/Dhaka
