# Copy to .env for local use, or paste these into Vercel's Environment Variables.
# .env is gitignored — never commit real values.

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL unset to use the local shop.db file next to server.js.
# For Turso, both come from `turso db show` and `turso db tokens create`.
DATABASE_URL=libsql://your-database-name-yourorg.turso.io
DATABASE_AUTH_TOKEN=

# --- Sessions -------------------------------------------------------------
# Signs the login cookie. Without it, logins do not survive a restart.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- First admin account --------------------------------------------------
# Used ONLY when the admin table is empty. After the first run, change the
# password from inside the app; these are then ignored.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# --- Optional ------------------------------------------------------------
# The shop's timezone, used to stamp the date and time on each sale. Defaults
# to Asia/Dhaka, so you only need this if the shop moves.
#
# Do NOT try to set TZ or NODE_ENV on Vercel — both are reserved names there and
# will be rejected. The app does not need either: the timezone is applied
# explicitly in code, and Vercel sets NODE_ENV=production itself.
# SHOP_TIMEZONE=Asia/Dhaka
